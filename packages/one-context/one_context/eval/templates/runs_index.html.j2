<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
<meta charset="utf-8">
<title>{{ skill }} / {{ scenario }} · runs ({{ total }})</title>
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    darkMode: 'class',
    theme: { extend: { fontFamily: {
      sans: ['Inter', '-apple-system', 'PingFang SC', 'sans-serif'],
      mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
      display: ['"SF Pro Display"', 'Inter', 'sans-serif'],
    }}},
  };
</script>
<style>
  body { font-feature-settings: "ss01", "cv11", "tnum"; -webkit-font-smoothing: antialiased; }
  .conic-bg {
    background:
      radial-gradient(800px 400px at 80% -10%, rgba(16,185,129,.10), transparent 60%),
      radial-gradient(600px 300px at -10% 100%, rgba(99,102,241,.08), transparent 60%),
      #09090b;
  }
  .gridlines {
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 32px 32px;
  }
</style>
</head>
<body class="conic-bg text-zinc-200 font-sans min-h-screen">
  <div class="gridlines min-h-screen">
    <div class="max-w-7xl mx-auto px-6 py-8">

      <!-- crumbs -->
      <div class="text-[10px] tracking-[0.18em] uppercase font-semibold text-zinc-500 mb-3">
        onecxt eval · runs
      </div>
      <h1 class="font-display text-4xl font-semibold tracking-tight mb-1">
        {{ skill }} <span class="text-zinc-600">×</span> {{ scenario }}
      </h1>
      <div class="text-sm text-zinc-500 mb-6">
        {{ total }} run{{ total != 1 and 's' or '' }} ·
        <span class="text-emerald-400">{{ passed }} passed</span> ·
        {% if failed %}<span class="text-rose-400">{{ failed }} failed</span> · {% endif %}
        pass-rate <span class="font-mono">{{ pass_rate_pct }}%</span> ·
        generated <span class="font-mono">{{ generated_at }}</span>
      </div>

      <!-- KPI tiles -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        <div class="rounded-xl border border-zinc-800/80 bg-zinc-950/60 backdrop-blur p-4">
          <div class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-semibold mb-1">Total runs</div>
          <div class="text-2xl font-display font-semibold tabular-nums">{{ total }}</div>
        </div>
        <div class="rounded-xl border border-zinc-800/80 bg-zinc-950/60 backdrop-blur p-4">
          <div class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-semibold mb-1">Pass rate</div>
          <div class="text-2xl font-display font-semibold tabular-nums
                      {{ pass_rate_pct >= 80 and 'text-emerald-400' or (pass_rate_pct >= 50 and 'text-amber-400' or 'text-rose-400') }}">{{ pass_rate_pct }}%</div>
        </div>
        <div class="rounded-xl border border-zinc-800/80 bg-zinc-950/60 backdrop-blur p-4">
          <div class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-semibold mb-1">Avg score</div>
          <div class="text-2xl font-display font-semibold tabular-nums">{{ avg_score if avg_score is not none else '—' }}</div>
        </div>
        <div class="rounded-xl border border-zinc-800/80 bg-zinc-950/60 backdrop-blur p-4">
          <div class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-semibold mb-1">Total cost</div>
          <div class="text-2xl font-display font-semibold tabular-nums">{{ total_cost_human }}</div>
          <div class="text-[10px] text-zinc-500 mt-1 font-mono">avg {{ avg_duration_human }} / run</div>
        </div>
      </div>

      <!-- runs table -->
      <div class="rounded-2xl border border-zinc-800/80 bg-zinc-950/60 backdrop-blur overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-[10px] uppercase tracking-[0.088em] text-zinc-500 font-semibold border-b border-zinc-800/80">
              <th class="text-left px-4 py-3">Verdict</th>
              <th class="text-left px-4 py-3">Run id</th>
              <th class="text-left px-4 py-3">Timestamp</th>
              <th class="text-right px-4 py-3">Score</th>
              <th class="text-right px-4 py-3">Cost</th>
              <th class="text-right px-4 py-3">Duration</th>
              <th class="text-left px-4 py-3">Model</th>
              <th class="text-left px-4 py-3">Git</th>
              <th class="text-right px-4 py-3">Tools</th>
              <th class="text-right px-4 py-3">Artifacts</th>
              <th class="text-right px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            {% if not runs %}
            <tr>
              <td colspan="11" class="px-6 py-12 text-center text-zinc-500">
                No runs yet. Run <code class="font-mono text-xs px-2 py-1 bg-zinc-800 rounded">onecxt eval {{ skill }}/{{ scenario }}</code> to generate one.
              </td>
            </tr>
            {% endif %}
            {% for r in runs %}
            <tr class="border-b border-zinc-800/40 hover:bg-zinc-900/40 transition cursor-pointer"
                onclick="window.location.href='{{ r.report_href }}'">
              <td class="px-4 py-3">
                {% if r.overall_pass %}
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2 py-1 rounded-full bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>PASS
                </span>
                {% else %}
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2 py-1 rounded-full bg-rose-500/15 text-rose-400 ring-1 ring-rose-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>FAIL
                </span>
                {% endif %}
              </td>
              <td class="px-4 py-3 font-mono text-xs text-zinc-300">{{ r.run_id }}</td>
              <td class="px-4 py-3 font-mono text-xs text-zinc-400">{{ r.timestamp }}</td>
              <td class="px-4 py-3 text-right tabular-nums font-mono">
                {% if r.judge_skipped %}
                <span class="text-zinc-500 text-xs">—</span>
                {% elif r.score is not none %}
                <span class="{{ r.judge_pass and 'text-emerald-400' or 'text-rose-400' }}">{{ '%.2f' | format(r.score) }}</span>
                {% if r.threshold is not none %}<span class="text-zinc-600 text-xs">/{{ '%.2f' | format(r.threshold) }}</span>{% endif %}
                {% else %}<span class="text-zinc-500 text-xs">—</span>{% endif %}
              </td>
              <td class="px-4 py-3 text-right tabular-nums font-mono text-zinc-300">{{ r.cost_human }}</td>
              <td class="px-4 py-3 text-right tabular-nums font-mono text-zinc-300">{{ r.duration_human }}</td>
              <td class="px-4 py-3 font-mono text-xs text-zinc-400 truncate max-w-[180px]">
                {{ r.actual_model or '?' }}
                {% if r.model_drift %}<span class="text-amber-400 text-xs ml-1" title="model drift detected">⚠</span>{% endif %}
              </td>
              <td class="px-4 py-3 font-mono text-xs text-zinc-500">{{ r.git_commit[:8] }}</td>
              <td class="px-4 py-3 text-right tabular-nums font-mono text-xs text-zinc-500">{{ r.tool_calls_count }}</td>
              <td class="px-4 py-3 text-right tabular-nums font-mono text-xs text-zinc-500">{{ r.artifact_count }}</td>
              <td class="px-4 py-3 text-right">
                <a href="{{ r.report_href }}" class="text-emerald-400 hover:text-emerald-300 text-xs font-semibold" onclick="event.stopPropagation()">open ↗</a>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="mt-6 text-xs text-zinc-600">
        <code class="font-mono">onecxt eval runs {{ skill }}/{{ scenario }}</code> · generated {{ generated_at }} ·
        rows sort by timestamp (newest first) · click a row to open that run's report.html
      </div>
    </div>
  </div>
</body>
</html>
