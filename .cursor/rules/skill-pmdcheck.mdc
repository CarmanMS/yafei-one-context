# Skill: pmdcheck

# PMD Check — Java 静态代码检查

智能 PMD 静态代码检查工具，自动发现 Java 项目并执行代码规范检查。

## Workflow

### 1. 定位 Java 项目

根据参数或当前目录确定项目根目录：

```bash
# 1. 如果指定了 scope，优先使用 scope 路径
if [[ -n "$ARG_SCOPE" ]]; then
    if [[ -d "$ARG_SCOPE" ]]; then
        # 如果是目录，进入该目录查找 pom.xml
        PROJECT_ROOT="$ARG_SCOPE"
        # 确保是绝对路径
        if [[ "$PROJECT_ROOT" != /* ]]; then
            PROJECT_ROOT="$(pwd)/$PROJECT_ROOT"
        fi
        
        # 递归向上查找 pom.xml
        while [[ "$PROJECT_ROOT" != "/" ]]; do
            if [[ -f "$PROJECT_ROOT/pom.xml" ]]; then
                echo "✅ 在 scope 路径中找到项目: $PROJECT_ROOT"
                break
            fi
            PROJECT_ROOT=$(dirname "$PROJECT_ROOT")
        done
    else
        echo "❌ 指定的 scope 路径不存在: $ARG_SCOPE"
        exit 1
    fi
fi

# 2. 如果没指定 scope 或在上述过程中没找到，从当前目录向上查找
if [[ -z "$PROJECT_ROOT" || ! -f "$PROJECT_ROOT/pom.xml" ]]; then
    current_dir=$(pwd)
    while [[ "$current_dir" != "/" ]]; do
        if [[ -f "$current_dir/pom.xml" ]]; then
            PROJECT_ROOT="$current_dir"
            echo "✅ 找到最近的 Maven 项目: $PROJECT_ROOT"
            break
        fi
        current_dir=$(dirname "$current_dir")
    done
fi

# 如果最后还没找到，提示用户
if [[ -z "$PROJECT_ROOT" || ! -f "$PROJECT_ROOT/pom.xml" ]]; then
    echo "❌ 未找到 Maven 项目 (pom.xml)，请在 Java 项目目录内执行或指定正确的 --scope"
    exit 1
fi
```

### 2. 分析检查范围

获取变更的 Java 文件（如果未指定 --all）：

```bash
# 获取 git 仓库根目录
cd "$PROJECT_ROOT"
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")

if [[ -n "$GIT_ROOT" && -z "$ARG_ALL" ]]; then
    # 获取变更的 Java 文件
    CHANGED_FILES=$(git status --porcelain | grep '\.java$' | sed 's/^.. //' | tr '\n' ',')
    if [[ -n "$CHANGED_FILES" ]]; then
        echo "检测到变更的 Java 文件，将只检查这些文件"
        CHECK_SCOPE="changed"
    else
        echo "没有检测到变更的 Java 文件，将检查整个项目"
        CHECK_SCOPE="all"
    fi
else
    CHECK_SCOPE="all"
fi
```

### 3. 确定 PMD 规则集

优先使用项目配置的规则集，否则使用默认规则：

```bash
# 查找项目规则集（按优先级）
RULESET_FILE=""

# 1. 检查项目根目录的自定义规则集
if [[ -f "$PROJECT_ROOT/pmd-ruleset.xml" ]]; then
    RULESET_FILE="$PROJECT_ROOT/pmd-ruleset.xml"
    echo "✅ 使用项目规则集: pmd-ruleset.xml"
elif [[ -f "$PROJECT_ROOT/.pmd/ruleset.xml" ]]; then
    RULESET_FILE="$PROJECT_ROOT/.pmd/ruleset.xml"
    echo "✅ 使用项目规则集: .pmd/ruleset.xml"
# 2. 检查仓库根目录的共享规则集
elif [[ -f "${PMD_RULESET:-$GIT_ROOT/pmd-ruleset.xml}" ]]; then
    RULESET_FILE="${PMD_RULESET:-$GIT_ROOT/pmd-ruleset.xml}"
    echo "✅ 使用仓库根共享规则集"
# 3. 使用默认规则集
else
    echo "⚠️  未找到自定义规则集，使用默认规则"
    RULESET_FILE="/tmp/pmd-ruleset-default-$$.xml"
    
    cat > "$RULESET_FILE" << 'RULESET_EOF'
<?xml version="1.0"?>
<ruleset name="default-pmd-rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD default rules - Import related checks</description>

    <!-- 无效 import -->
    <rule ref="category/java/bestpractices.xml/UnusedImports"/>

    <!-- 冗余 import -->
    <rule ref="category/java/codestyle.xml/DuplicateImports"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryFullyQualifiedName"/>

    <!-- 同包 import（通常是误操作） -->
    <rule ref="category/java/errorprone.xml/ImportFromSamePackage"/>
</ruleset>
RULESET_EOF
fi
```

### 4. 检查 PMD 可用性

检查项目是否已配置 PMD 插件：

```bash
# 检查 pom.xml 是否已配置 PMD 插件
if grep -q "maven-pmd-plugin" "$PROJECT_ROOT/pom.xml"; then
    echo "✅ 项目已配置 PMD 插件"
    USE_MAVEN_PMD=true
else
    echo "⚠️ 项目未配置 PMD 插件，将使用临时配置"
    USE_MAVEN_PMD=false
fi

# 也检查系统 PMD
if command -v pmd &> /dev/null; then
    echo "✅ 系统已安装 PMD"
    USE_SYSTEM_PMD=true
else
    USE_SYSTEM_PMD=false
fi
```

### 5. 准备临时 POM 配置（如果需要）

如果项目没有 PMD 插件，创建临时配置：

```bash
# 临时 POM 文件（如果需要）
TEMP_POM=""

if [[ "$USE_MAVEN_PMD" == false ]]; then
    # 创建临时 POM 片段用于 PMD 检查
    TEMP_POM_DIR="/tmp/pmd-check-$$"
    mkdir -p "$TEMP_POM_DIR"

    # 提取原始 POM 的 groupId, artifactId, version
    POM_GROUP=$(grep -o '<groupId>[^<]*' "$PROJECT_ROOT/pom.xml" | head -1 | sed 's/<groupId>//')
    POM_ARTIFACT=$(grep -o '<artifactId>[^<]*' "$PROJECT_ROOT/pom.xml" | head -1 | sed 's/<artifactId>//')
    POM_VERSION=$(grep -o '<version>[^<]*' "$PROJECT_ROOT/pom.xml" | head -1 | sed 's/<version>//')

    cat > "$TEMP_POM_DIR/pom.xml" << POM_EOF
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>${POM_GROUP:-com.example}</groupId>
    <artifactId>${POM_ARTIFACT:-temp}-pmd-check</artifactId>
    <version>${POM_VERSION:-1.0.0}</version>
    <packaging>pom</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.21.2</version>
                <configuration>
                    <rulesets>
                        <ruleset>${RULESET_FILE}</ruleset>
                    </rulesets>
                    <printFailingErrors>true</printFailingErrors>
                    <failOnViolation>false</failOnViolation>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
POM_EOF

    TEMP_POM="$TEMP_POM_DIR/pom.xml"
    echo "临时 POM 创建完成: $TEMP_POM"
fi
```

### 6. 执行 PMD 检查

运行 PMD 检查：

```bash
# 准备输出文件
REPORT_FILE="/tmp/pmd-report-$$.txt"
REPORT_XML="/tmp/pmd-report-$$.xml"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "           开始 PMD 静态代码检查"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "项目路径: $PROJECT_ROOT"
echo "检查范围: $CHECK_SCOPE"
echo ""

# 执行 PMD 检查
if [[ "$USE_MAVEN_PMD" == true ]]; then
    # 使用项目自带的 PMD 插件
    echo "使用项目 PMD 插件执行检查..."
    cd "$PROJECT_ROOT"

    # 尝试不同的调用方式
    echo "正在执行 mvn pmd:pmd (可能需要几分钟，正在下载依赖或扫描代码)..."
    if ! mvn pmd:pmd -Dpmd.rulesets="$RULESET_FILE" -DfailOnViolation=false 2>&1 | tee "$REPORT_FILE"; then
        echo "⚠️ PMD 执行可能遇到问题，继续解析结果..."
    fi

    # 查找生成的报告
    if [[ -f "target/pmd.xml" ]]; then
        cp "target/pmd.xml" "$REPORT_XML"
    fi
elif [[ "$USE_SYSTEM_PMD" == true ]]; then
    # 使用系统 PMD
    echo "使用系统 PMD 执行检查..."
    cd "$PROJECT_ROOT"

    # 构建文件列表
    if [[ "$CHECK_SCOPE" == "changed" && -n "$CHANGED_FILES" ]]; then
        FILE_LIST=$(echo "$CHANGED_FILES" | tr ',' '\n' | while read f; do
            if [[ -f "$f" ]]; then echo "$f"; fi
        done | tr '\n' ',')
        pmd check -d "$PROJECT_ROOT" -R "$RULESET_FILE" -f xml -r "$REPORT_XML" --file-list "$FILE_LIST" 2>&1 || true
    else
        pmd check -d "$PROJECT_ROOT" -R "$RULESET_FILE" -f xml -r "$REPORT_XML" 2>&1 || true
    fi
else
    # 使用临时 POM
    echo "使用临时 POM 执行 PMD 检查..."
    cd "$PROJECT_ROOT"

    # 尝试执行 PMD
    echo "正在使用临时 POM 执行扫描..."
    mvn -f "$TEMP_POM" pmd:pmd -Dpmd.sourceDirectory="$PROJECT_ROOT/src" -DfailOnViolation=false 2>&1 | tee "$REPORT_FILE" || true

    if [[ -f "$TEMP_POM_DIR/target/pmd.xml" ]]; then
        cp "$TEMP_POM_DIR/target/pmd.xml" "$REPORT_XML"
    fi
fi

# 如果没有 XML 报告，尝试从文本输出解析
if [[ ! -f "$REPORT_XML" && -f "$REPORT_FILE" ]]; then
    echo "尝试从文本输出解析..."
fi
```

### 7. 解析并显示结果

解析 PMD 报告并格式化输出：

```bash
# 解析结果并显示
python3 << PYTHON_EOF
import xml.etree.ElementTree as ET
import re
import sys

report_file = "$REPORT_XML"

# 统计数据
stats = {
    "total_files": 0,
    "total_violations": 0,
    "by_rule": {},
    "by_file": {}
}

try:
    if report_file and open(report_file, 'r').read().strip().startswith('<'):
        tree = ET.parse(report_file)
        root = tree.getroot()

        for file_elem in root.findall('.//file'):
            filename = file_elem.get('name', '')
            stats["total_files"] += 1

            for violation in file_elem.findall('violation'):
                stats["total_violations"] += 1
                rule = violation.get('rule', 'Unknown')
                line = violation.get('beginline', '0')
                message = violation.text.strip() if violation.text else ''

                # 按规则统计
                stats["by_rule"][rule] = stats["by_rule"].get(rule, 0) + 1

                # 按文件统计
                if filename not in stats["by_file"]:
                    stats["by_file"][filename] = []
                stats["by_file"][filename].append({
                    "rule": rule,
                    "line": line,
                    "message": message
                })
except Exception as e:
    print(f"解析报告时出错: {e}", file=sys.stderr)

# 输出报告
print("="*60)
print("               PMD 检查报告")
print("="*60)
print()

if stats["total_violations"] == 0:
    print("✅ 恭喜！未发现代码规范问题")
else:
    print(f"📊 统计概览")
    print(f"   检查文件: {stats['total_files']} 个")
    print(f"   发现问题: {stats['total_violations']} 个")
    print()

    if stats["by_rule"]:
        print("   按规则分布:")
        print("   ┌" + "─"*35 + "┬" + "─"*10 + "┐")
        print(f"   │ {'规则名称':<33} │ {'数量':^8} │")
        print("   ├" + "─"*35 + "┼" + "─"*10 + "┤")
        for rule, count in sorted(stats["by_rule"].items(), key=lambda x: -x[1]):
            print(f"   │ {rule:<33} │ {count:>8} │")
        print("   └" + "─"*35 + "┴" + "─"*10 + "┘")

    print()
    print("📁 问题详情")
    print()

    for filename, violations in sorted(stats["by_file"].items()):
        # 简化文件路径
        short_name = filename.split('/src/')[-1] if '/src/' in filename else filename.split('/')[-3:]
        if isinstance(short_name, list):
            short_name = '/'.join(short_name)

        print(f" {short_name}")
        print(f" {'─'*58}")
        for v in violations:
            print(f" ⚠️  {v['rule']} (Line {v['line']})")
            if v['message']:
                print(f"     {v['message'][:80]}")
        print()

print("="*60)

# 输出 JSON 给后续步骤
import json
print(f"\n<!--PMD_STATS-->{json.dumps(stats)}<!--PMD_STATS_END-->")

PYTHON_EOF
```

