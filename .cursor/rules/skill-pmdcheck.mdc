    # 提取需要修复的文件列表
    python3 << EXTRACT_FILES
import xml.etree.ElementTree as ET
import json

try:
    tree = ET.parse("$REPORT_XML")
    root = tree.getroot()

    # 收集所有有问题的文件及其违规信息
    files_to_fix = {}

    for file_elem in root.findall('.//file'):
