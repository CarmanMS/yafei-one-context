# Sub-repositories & optional external/ clones: not committed; see meta/repos.yaml and scripts/sync_repos.py
repos/**
!repos/**/.gitkeep

# Git worktrees (isolated feature development)
.worktrees/



# Python
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Node — all node_modules everywhere
**/node_modules/

# Node (repo root / feature production sandboxes — do not commit)
node_modules/

# Node (skills: html-video-from-slides CLI)
skills/html-video-from-slides/node_modules/
skills/html-video-from-slides/.cache/

# Feature pipelines: local npm installs; wav/tts 中间文件（cli 写入 production/tmp/）
features/**/production/node_modules/
features/**/production/tmp/
# 旧版目录名，若本地仍有残留则继续忽略
features/**/production/temp_video_wav/
features/**/production/temp_video/

# Local CLI / scratch (repo root)
# Same dunder-safe constraint as the global rule below: second char must
# be a lowercase letter so __init__.py / __main__.py are NOT caught.
.opencli/
/_[a-z]*.py
/_*.ps1
/_shots_*/
skills/.skills_store_lock.json
# Skill demos (local preview output, not for repo)
skill-demos/
# Skill version lock file (local, regenerated)
skills-lock.json

# Local archive zone (V1 of 报废方案 / spike artifacts / 临时落盘)
_tmp/

# Testing
.coverage
.pytest_cache/

# Local env (proxy, etc.); README "Network / HTTP proxy"
.env

# Doubao TTS: copy local.env.example → local.env（勿提交）
skills/doubao-dialogue-tts/local.env
skills/volc-podcast-tts/local.env
# Obsidian Local REST API key (secret, local only — 勿提交)
skills/obsidian-knowledge/api-key.txt

# Local AI research repo (separate remote: CarmanMS/paperwork) — not tracked here
ai/
# Assistant runtime working memory (project-local, generated) — not tracked here
.workbuddy/memory/

# Features: production/ — track creative assets, ignore media & temp
# See features/_template/content-production/ for canonical layout
features/**/production/tmp/
features/**/production/media/
features/**/production/**/*.wav
features/**/production/**/*.mp4
features/**/production/**/*.png
features/**/production/**/*.jpg
features/**/production/**/*.jpeg
features/**/production/**/*.pdf
features/**/production/**/*.webm
features/**/production/**/*.bak
features/**/production/node_modules/
features/**/production/**/*.log
# 定稿字幕：production/subtitles/*.srt 纳入版本控制（不忽略 *.srt；tmp/ 整目录已忽略）
# Remotion: 保留源代码；只排除产物目录
features/**/production/remotion/

# Features: temporary build artifacts
features/**/temp_*/
features/**/scratch/
tmp/

# Remotion render logs (runtime artifacts)
features/**/remotion*/**/*.log

# Ad-hoc scripts with _ prefix (fix, search, test, etc.)
# Constraint: the second char must be a lowercase letter so dunder files
# (__init__.py / __main__.py) are NOT caught.
_[a-z]*_*.py
_*-*.txt
_search*.cjs
# Exception: one_context CLI / usage_eval sub-modules legitimately use
# _xxx_yyy.py naming (e.g. _usage_eval.py). They are package code, not ad-hoc.
!packages/one-context/one_context/cli/_*.py
!packages/one-context/one_context/usage_eval/_*.py

# Step session runtime data
features/**/production/.step/
features/**/production/.shell_ready
features/**/production/build-result.txt
features/**/production/video-build.log

# Video media files (generated, not for repo)
*.mp4
*.webm
*.wav

# Backup files
*.bak
backups/

# Test screenshots & media
*.png
*.jpg
*.jpeg
deck-slides/

# OS
.DS_Store
*.swp

# IDEs
.idea/
.vscode/
.obsidian/
.codefuse/

# Agent runtime (local, personal) — keep small project manifest committable
.openclaw/**
!.openclaw/onecxt-project.json
!.openclaw/agents/
!.openclaw/skills/
memory/*
!memory/.gitkeep
!memory/README.md

# Generated tool configs (run `onecxt adapt` locally)
# Tracked so all tools stay in sync from meta/agents.yaml
!.cursor/rules/
!.claude/agents/
!.claude/adapters/
!.claude/skills/
!.claude/skills/*.md
!CLAUDE.md

# External symlinks (point to other repos, not one-context assets)
.claude/commands/

# Tool runtime (Playwright MCP etc.)
.playwright-mcp/

# Superpowers runtime (brainstorm output, etc.)
.superpowers/

# Hermes (adapt generated, tracked)
!.hermes/
!.hermes.md

# Personal Agent config files (not project context)
HEARTBEAT.md
IDENTITY.md
SOUL.md
USER.md
TOOLS.md
canvas-philosophy.md
/cover*.html

# Skill parallel verify runtime output
.skill-parallel-verify/

# Feature pipeline runtime output (generated by remotion-canvas etc.)
features/**/visual-narrative-out/

# Skills runtime artifacts (build output, render props, etc.)
skills/remotion-canvas/public/
/public/
skills/remotion-canvas/run-render.mjs

# Local one-context config (sensitive word lists, etc.)
.onecxt/sensitive-words.yaml
# Adapt cache (incremental build state)
.onecxt/adapt-cache.json

# Node lock files — contain internal registry URLs, never commit
**/package-lock.json

# NLP models (large binary files)
models/

# Claude Code local settings (personal, not shared)
.claude/settings.json
# Test screenshots
tester*-screenshot.png
.claude/skills/README.md

features/**/production/media/**

features/**/production/tmp/**

features/**/production/remotion/

# 注意：features/**/src/ 的排除规则已移至 features/**/production/remotion/
# 避免误伤 remotion/src/ 等源代码目录
# 如需排除特定 src/ 请在该项目 production/remotion/ 级别处理

features/**/public/**
# Exception: Remotion audio placeholder is trackable source
!features/**/remotion/public/audio/.gitkeep

features/**/node_modules/

# Skill eval runner outputs (per-run reports). Baselines are committed.
skills/**/evals/*/__reports/

# Runtime output directory at repo root only (do NOT use bare production/ — that ignores features/**/production/)
/production/

# skill eval 运行时产物
skills/*/__usage_eval/

# npm cache
.npm-cache/
# loop-engineering 实例:本地运行产物,整个 loops 实例不入库;只保留骨架
loops/*
!loops/.gitkeep
!loops/_template/
!loops/_template/**

# 敏感脚本（读取浏览器凭据），勿入库
read_cookies.py

# 本地生成/下载的大文件（安装器等），勿入库（GitHub 限制 100MB）
output/**/*.exe
